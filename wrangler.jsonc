{
  // Cloudflare Workers static-assets config (deployed with `wrangler deploy`).
  //
  // - `build.command` runs the Vite build first, so `wrangler deploy` works on
  //   a clean checkout even when the CI pipeline has no separate build step.
  // - `assets.directory` publishes ./dist, including the `_headers` file Vite
  //   copies there from ./public.
  // - `run_worker_first` sends every request through worker/index.ts before
  //   the asset server, which is what enforces the direct-URL redirect
  //   (embed protection — see reference/embed-protection.md).
  //
  // Deploy:  npx wrangler deploy
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "munshot-ai-analyst-live-quote",
  "compatibility_date": "2026-09-08",
  "main": "worker/index.ts",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  }
}
